      "items": [
        {
          "id": "aud-ji",
          "prompt": "じ",
          "english": "ji — the common one",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-di",
          "prompt": "ぢ",
          "english": "also ji — rare, same sound",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-zu",
          "prompt": "ず",
          "english": "zu — the common one",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-du",
          "prompt": "づ",
          "english": "also zu — rare, same sound",
          "recordLabel": "Record your answer"
        }
      ]
