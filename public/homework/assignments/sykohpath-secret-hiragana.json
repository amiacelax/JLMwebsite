  "sections": [
    {
      "id": "sec-compare",
      "mode": "multiple-choice",
      "title": "Which one?",
      "instructions": "Drag or tap the correct kana into the blank.",
      "items": [
        {
          "id": "mc-tsu",
          "prompt": "どっちが大きいですか？ ______",
          "english": "Which one is the big one?",
          "choices": [
            "つ",
            "っ"
          ],
          "answer": "つ"
        },
        {
          "id": "mc-yoon-small",
          "prompt": "やゃ ゆゅ よょ — どっちが小さいですか？ ______",
          "english": "Which ones are the small ones?",
          "choices": [
            "ゃゅょ",
            "やゆよ"
          ],
          "answer": "ゃゅょ"
        },
        {
          "id": "mc-konnichiwa",
          "prompt": "Choose the correct greeting: ______",
          "english": "\"Hello\" — only one spelling is correct.",
          "choices": [
            "こんにちは",
            "こんにちわ"
          ],
          "answer": "こんにちは"
        }
      ]
    },
    {
      "id": "sec-read-record",
      "mode": "audio-prompt",
      "title": "Read & record",
      "instructions": "Read each word out loud and record yourself.",
      "items": [
        {
          "id": "aud-gakkou",
          "prompt": "学校（がっこう）",
          "english": "school — watch the small っ pause",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-chotto",
          "prompt": "ちょっと",
          "english": "a little / hang on a sec — small ょ, then a pause",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-geemu",
          "prompt": "ゲームを買った（げーむをかった）",
          "english": "I bought a game",
          "recordLabel": "Record your answer"
        }
      ]
    },
    {
      "id": "sec-wo-o",
      "mode": "audio-prompt",
      "title": "を and お",
      "instructions": "Type the sound in romaji (or English), then record yourself saying it.",
      "items": [
        {
          "id": "aud-wo",
          "prompt": "を",
          "english": "the particle — written \"wo\", said \"o\"",
          "typeIn": true,
          "typeInLabel": "Type in romaji / English",
          "typeInAnswer": "o",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-o",
          "prompt": "お",
          "english": "the kana \"o\" — same sound as を",
          "typeIn": true,
          "typeInLabel": "Type in romaji / English",
          "typeInAnswer": "o",
          "recordLabel": "Record your answer"
        }
      ]
    },
    {
      "id": "sec-ryu",
      "mode": "audio-prompt",
      "title": "Ryu",
      "instructions": "Look at the image, then record the name.",
      "items": [
        {
          "id": "aud-ryu-en",
          "prompt": "Ryu",
          "english": "the name as you'd read it in English",
          "imageUrl": "/homework/media/secret-hira-ryu-en.webp",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-ryu-ja",
          "prompt": "リュウ",
          "english": "the same name in katakana — one smooth \"ryu\", not \"ri-yu\"",
          "imageUrl": "/homework/media/secret-hira-ryu-ja.webp",
          "recordLabel": "Record your answer"
        }
      ]
    },
    {
      "id": "sec-ra-row",
      "mode": "audio-prompt",
      "title": "らりるれろ · りゃりゅりょ",
      "instructions": "Record each line clearly.",
      "items": [
        {
          "id": "aud-rarirurero",
          "prompt": "らりるれろ",
          "english": "the ra row: ra ri ru re ro",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-ryaryuryo",
          "prompt": "りゃ　りゅ　りょ",
          "english": "rya ryu ryo — one beat each",
          "recordLabel": "Record your answer"
        }
      ]
    },
    {
      "id": "sec-ii",
      "mode": "audio-prompt",
      "title": "ちいさい · おおきい · かわいい",
      "instructions": "Record each word.",
      "items": [
        {
          "id": "aud-chiisai",
          "prompt": "ちいさい",
          "english": "small — hold the い",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-ookii",
          "prompt": "おおきい",
          "english": "big — hold the お and the い",
          "recordLabel": "Record your answer"
        },
        {
          "id": "aud-kawaii",
          "prompt": "かわいい",
          "english": "cute — hold the last い",
          "recordLabel": "Record your answer"
        }
      ]
    },
    {
      "id": "sec-ji-zu",
      "mode": "audio-prompt",
      "title": "じ · ぢ · ず · づ",
