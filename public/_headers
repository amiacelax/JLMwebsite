# Keep hub HTML fresh after deploys (don't let edge/browser keep an old shell).
/*.html
  Cache-Control: private, no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/homework/*
  Cache-Control: private, no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Versioned JS/CSS (?v=) can revalidate; prefer fresh after deploy.
# Allow brief browser reuse + SWR so repeat visits avoid full re-downloads.
/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Immutable-ish static media (filenames are stable; redeploy busts via new deploy hash at edge).
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000
  CDN-Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
  CDN-Cache-Control: public, max-age=2592000
