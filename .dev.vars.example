# Copy to .dev.vars (gitignored) for local wrangler dev:
#   copy .dev.vars.example .dev.vars
#
# Create a webhook in your Discord notify channel (ID 1534083802102501539):
#   Edit Channel → Integrations → Webhooks → New Webhook
# Contact, promo, birthdays, social reminders, homework, and video uploads all use this channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_CHANNEL_ID=1534083802102501539

# Same channel by default (can match DISCORD_WEBHOOK_URL)
DISCORD_HOMEWORK_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_HW_ID/YOUR_HW_TOKEN
DISCORD_HOMEWORK_CHANNEL_ID=1534083802102501539

# Student DMs on publish / review-ready (bot). Without these, notify falls back to homework webhook.
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_TEACHER_USER_ID=your-discord-snowflake

# Homework maker — OPTIONAL. The maker works with NO keys (built-in templates).
# Only add this if you sign up at platform.openai.com and want smarter AI drafts:
# OPENAI_API_KEY=sk-...
#
# Harris Firm client preview (password-protected, noindex)
# HARRIS_PREVIEW_USER=harris
# HARRIS_PREVIEW_PASSWORD=your-secret-password
#
# JEM Appraisals client preview (password-protected, noindex)
# JEM_PREVIEW_USER=jem
# JEM_PREVIEW_PASSWORD=jem

# Mistakes quick-log page (/homework/mistakes-log.html?key=…)
# Generate a long random string; set the same value in production:
#   wrangler secret put MISTAKES_LOG_KEY
# MISTAKES_LOG_KEY=your-long-random-secret-here
#
# Local dev only — auto-loads key on localhost (no ?key= in URL needed)
# LOCAL_DEV=1

# PayPal Subscriptions API (return URL after checkout). Live app Client ID + Secret:
#   https://developer.paypal.com/dashboard/applications/live
#   wrangler secret put PAYPAL_CLIENT_ID
#   wrangler secret put PAYPAL_CLIENT_SECRET
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live
#
# Without these, homework plan checkout still uses the plain PayPal subscribe link
# and the “I’ve paid — continue” confirm on return.

# Resend — Gmail copies of contact + promo form (Discord still fires). Free tier is enough.
# 1) Sign up https://resend.com → Domains → add japaneselanguagementor.com → add DNS records
# 2) API Keys → create key → paste here / production secret:
#   npx wrangler secret put RESEND_API_KEY
# Optional overrides (defaults live in wrangler.toml [vars]):
# INQUIRY_EMAIL_TO=languagementor.jp@gmail.com
# INQUIRY_EMAIL_FROM=Japanese Language Mentor <inquiries@japaneselanguagementor.com>
# RESEND_API_KEY=

# Your Cloudflare API token (for wrangler login / deploy) is NOT the same thing — you do not put it here.
#
# PayPal REST (homework subscriptions). Production secrets:
#   wrangler secret put PAYPAL_CLIENT_ID
#   wrangler secret put PAYPAL_CLIENT_SECRET
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live
